# Server-only settings. Do not expose these through VITE_* variables.
HOST=127.0.0.1
PORT=8876
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Optional local parquet archive used by the historical collectors.
AVACACHE_DIR=./data/avax-data-parquet
COLLECT_LOOKBACK_DAYS=30
COLLECT_TIMEOUT_MS=30000
MAX_SOURCE_AGE_HOURS=36

# Optional separately operated Avalanche Gateway. Leave unset to use the
# committed snapshots and gracefully degrade gateway-backed live features.
AVAX_RADAR_URL=
AVAX_RADAR_TIMEOUT_MS=8000
AVAX_RADAR_MAX_AGE_SECONDS=120
AVAX_RADAR_ACTIVITY_LIMIT=100
