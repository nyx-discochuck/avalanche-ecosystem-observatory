[Unit]
Description=Refresh Avalanche Ecosystem Observatory snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/openclaw/avalanche-ecosystem-dashboard
Environment=NODE_ENV=production
EnvironmentFile=-/home/openclaw/avalanche-ecosystem-dashboard/.env
ExecStart=/usr/bin/node /home/openclaw/avalanche-ecosystem-dashboard/scripts/collect.mjs
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/home/openclaw/.openclaw/workspace/archive/avax-data-parquet
ReadWritePaths=/home/openclaw/avalanche-ecosystem-dashboard/public/data /home/openclaw/avalanche-ecosystem-dashboard/state
StandardOutput=journal
StandardError=journal
